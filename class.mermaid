---
config:
  theme: neutral
  layout: elk
  look: classic
---
classDiagram
    direction LR
    class Animal {
        +id: bigint
        +name: varchar
        +slug: varchar
        +barcode: varchar
        +category_animals_id: bigint
        +breeds_id: bigint
        +age: varchar
        +weight: decimal
        +gender: enum
        +health_status: varchar
        +vaccination_status: tinyint
        +thumbnail: varchar
        +description: longtext
        +stock: int
        +purchase_price: decimal
        +selling_price: decimal
        +is_active: tinyint
        +created_at: timestamp
        +updated_at: timestamp
        +deleted_at: timestamp
        +addAnimal()
        +updateAnimal()
        +deleteAnimal()
        +restoreAnimal()
        +getAnimals()
        +getAnimalById()
        +updateStock()
    }
    class AnimalPhoto {
        +id: bigint
        +photo: varchar
        +animals_id: bigint
        +created_at: timestamp
        +updated_at: timestamp
        +deleted_at: timestamp
        +addPhoto()
        +updatePhoto()
        +deletePhoto()
        +restorePhoto()
        +getPhotosByAnimal()
    }
    class Brand {
