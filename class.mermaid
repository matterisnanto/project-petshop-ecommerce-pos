%% // --- Relasi One-to-Many ---
Animal "1" -- "0..*" AnimalPhoto : "has"
Product "1" -- "0..*" ProductPhoto : "has"
Breeding "1" -- "0..*" BreedingPackage : "has"
Grooming "1" -- "0..*" GroomingPackage : "has"
Hotel "1" -- "0..*" HotelPackage : "has"
Order "1" -- "0..*" PetInformation : "has"
PurchaseReturn "1" -- "0..*" ReturnItem : "has"
TransactionReturn "1" -- "0..*" ReturnItem : "has"

%% // --- Relasi Many-to-One ---
Animal "1..*" -- "1" CategoryAnimal : "belongs to"
Animal "1..*" -- "1" Breed : "belongs to"
Product "1..*" -- "1" Category : "belongs to"
Product "1..*" -- "1" Brand : "belongs to"
Product "1..*" -- "1" CategoryAnimal : "belongs to"
Breed "1..*" -- "1" CategoryAnimal : "belongs to"
Grooming "1..*" -- "1" CategoryGrooming : "belongs to"
Grooming "1..*" -- "1" CategoryAnimal : "belongs to"
Hotel "1..*" -- "1" CategoryAnimal : "belongs to"
Breeding "1..*" -- "1" CategoryAnimal : "belongs to"
Breeding "1..*" -- "1" Breed : "belongs to"
PetInformation "1..*" -- "1" CategoryAnimal : "belongs to"
Order "1..*" -- "1" PosTransaction : "belongs to"
Order "1..*" -- "1" OlshopTransaction : "belongs to"
Order "1..*" -- "1" Purchase : "belongs to"
Order "1..*" -- "1" Product : "contains"
Order "1..*" -- "1" Animal : "contains"
Order "1..*" -- "1" Grooming : "contains"
Order "1..*" -- "1" Breeding : "contains"
Order "1..*" -- "1" Hotel : "contains"
Purchase "1..*" -- "1" Supplier : "from"
PurchaseReturn "1..*" -- "1" Supplier : "to"
PurchaseReturn "1..*" -- "1" Purchase : "references"
TransactionReturn "1..*" -- "1" PosTransaction : "references"
TransactionReturn "1..*" -- "1" OlshopTransaction : "references"
ReturnItem "1..*" -- "1" Product : "references"
ReturnItem "1..*" -- "1" Animal : "references"
ReturnItem "1..*" -- "1" Grooming : "references"
ReturnItem "1..*" -- "1" Breeding : "references"
ReturnItem "1..*" -- "1" Hotel : "references"
OlshopTransaction "1..*" -- "1" PaymentMethod : "uses"
PosTransaction "1..*" -- "1" PaymentMethod : "uses"
OlshopTransaction "1..*" -- "1" PromoCode : "uses"
