        +trx_id: varchar
        +created_at: timestamp
        +updated_at: timestamp
        +deleted_at: timestamp
        +createTransaction()
        +updateTransaction()
        +cancelTransaction()
        +getTransactions()
        +getTransactionById()
    }
    class Product {
        +id: bigint
        +name: varchar
        +slug: varchar
        +barcode: varchar
        +weight: decimal
        +thumbnail: varchar
        +description: longtext
        +purchase_price: decimal
        +selling_price: decimal
        +is_active: tinyint
        +is_popular: tinyint
        +stock: int
        +category_id: bigint
        +brand_id: bigint
        +category_animals_id: bigint
        +created_at: timestamp
        +updated_at: timestamp
        +deleted_at: timestamp
        +addProduct()
        +updateProduct()
        +deleteProduct()
        +restoreProduct()
        +getProducts()
